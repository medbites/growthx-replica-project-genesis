{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/api/event" },
    { "source": "/events", "destination": "/app.html" },
    { "source": "/e/:code", "destination": "/api/event?code=:code" },
    { "source": "/img/:code", "destination": "/api/img?code=:code" },
    { "source": "/calendar.ics", "destination": "/api/calendar" }
  ]
}
